[feishu]
app_id = "${FEISHU_APP_ID}"
app_secret = "${FEISHU_APP_SECRET}"
input_merge_window_seconds = 3
menu_page_size = 8

[bot]
persona_style = "Speak like the Defect from Slay the Spire."
# Choose "zh-CN" or "en"
language = "zh-CN"
default_timezone = "Asia/Tokyo"

[maintenance]
enabled = true
idle_after_minutes = 15
tmp_retention_days = 7
